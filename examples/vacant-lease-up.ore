          "tiPerSF": 3.0,
          "lcPercentOfRent": 5.0,
          "freeRentMonths": 3
        },
        "renewal": {
          "tiPerSF": 1.0,
          "lcPercentOfRent": 2.5,
          "freeRentMonths": 1
        },
        "renewalRentPercentOfMarket": 100,
        "notes": "General rollover for every expiry after the first lease: shorter downtime, second-generation costs, 70% renewal."
      }
    },
    "notes": "Two leasing profiles on purpose: without rolloverProfile, the 12-month lease-up downtime would repeat at every later expiry."
