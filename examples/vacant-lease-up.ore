          "tiPerSF": 4.0,
          "lcPercentOfRent": 6.0,
          "freeRentMonths": 6
        },
        "rolloverProfile": "bulk",
        "notes": "First-generation lease of the vacant building: 12 months to sign and commence, first-generation TI and commissions, six months free. Renewal does not apply to a lease-up."
      },
      "bulk": {
        "marketRent": {
          "amount": 1.1,
          "unit": "per_sf_per_month"
        },
        "termMonths": 84,
        "escalation": {
          "type": "fixed_percent",
          "rate": 4.0,
          "frequencyMonths": 12
